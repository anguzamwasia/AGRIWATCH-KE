# ============================================================
# AgriWatch KE — Environment Variables Template
# © 2026 Cynthia Anguza. All Rights Reserved.
# ============================================================
# SAFE TO SHARE — contains no real credentials.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Google Gemini ---
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your-gemini-api-key-here

# --- Google Earth Engine ---
# Your GEE project ID (e.g. ee-yourname)
GEE_PROJECT=your-gee-project-id-here

# --- Mapbox ---
# Get from: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=your-mapbox-token-here

# --- PostgreSQL ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Local:      postgresql://postgres:password@localhost:5432/agriwatch_ke
# Render DB:  (auto-filled by render.yaml)
# Supabase:   postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/agriwatch_ke

# --- Data Paths (server-side only, never exposed to API) ---
# Absolute path to the directory containing the boundary shapefile
DATA_DIR=C:\Users\PC\Documents\kenya-yield-insight\Backend\data\boundaries

# --- App ---
APP_ENV=production
# Comma-separated allowed frontend origins
CORS_ORIGINS=https://agriwatch-ke.vercel.app,http://localhost:5173
